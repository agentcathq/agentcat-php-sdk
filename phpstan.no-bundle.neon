# PHPStan for the mcp/sdk main leg, which removes symfony/mcp-bundle (it requires mcp/sdk ^0.8.1).
includes:
    - phpstan.neon.dist
parameters:
    tmpDir: .cache/phpstan-no-bundle
    # (?) marks a path that PHPStan accepts before its tests exist.
    excludePaths:
        - tests/Support/Symfony
        - tests/Integration/Symfony (?)
        - tests/Contract/Symfony
        - tests/Integration/Conformance/SymfonyConformanceTest.php (?)
