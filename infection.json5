{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": ["src"]
    },
    "logs": {
        "text": ".cache/infection.log"
    },
    "minMsi": 90,
    "minCoveredMsi": 95,
    "mutators": {
        "@default": true
    },
    "testFramework": "phpunit",
    "testFrameworkOptions": "--testsuite=Unit,Golden,Integration,Contract"
}
