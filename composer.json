{
    "name": "agentcat/sdk",
    "description": "Analytics for MCP (Model Context Protocol) servers: session replay, intent, and telemetry for PHP MCP servers.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "mcp",
        "model-context-protocol",
        "analytics",
        "agentcat",
        "ai",
        "llm"
    ],
    "authors": [
        {
            "name": "AgentCat, Inc.",
            "email": "support@agentcat.com",
            "homepage": "https://agentcat.com"
        }
    ],
    "homepage": "https://agentcat.com",
    "support": {
        "issues": "https://github.com/agentcathq/agentcat-php-sdk/issues",
        "source": "https://github.com/agentcathq/agentcat-php-sdk",
        "docs": "https://docs.agentcat.com"
    },
    "require": {
        "php": "^8.3",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "composer-runtime-api": "^2.2",
        "agentcat/api": "~0.0.4",
        "psr/log": "^2.0 || ^3.0"
    },
    "require-dev": {
        "brianium/paratest": "^7.8.6",
        "ergebnis/composer-normalize": "^2.54",
        "ergebnis/phpunit-slow-test-detector": "^2.26",
        "infection/infection": "^0.35.8",
        "larastan/larastan": "^3.13",
        "laravel/framework": "^12.41.1 || ^13.0",
        "laravel/mcp": "^1.0",
        "mcp/sdk": "^0.8.1",
        "nyholm/psr7": "^1.8.2",
        "opis/json-schema": "^2.6",
        "orchestra/testbench": "^10.8 || ^11.3",
        "php-cs-fixer/shim": "3.95.27",
        "phpat/phpat": "^0.12.5",
        "phpdocumentor/type-resolver": "^1.10 || ^2.0",
        "phpstan/extension-installer": "^1.4.3",
        "phpstan/phpstan": "2.3.1",
        "phpstan/phpstan-deprecation-rules": "^2.0.5",
        "phpstan/phpstan-phpunit": "^2.1.1",
        "phpstan/phpstan-strict-rules": "^2.1",
        "phpunit/phpunit": "^12.5.40 || ^13.4.3",
        "rector/rector": "2.7.0",
        "shipmonk/composer-dependency-analyser": "^1.8.4",
        "spaze/phpstan-disallowed-calls": "^4.15",
        "symfony/cache-contracts": "^2.5.3 || ^3.4.2",
        "symfony/clock": "^6.4.3 || ^7.0.3 || ^8.0",
        "symfony/config": "^7.3.4 || ^8.0",
        "symfony/dependency-injection": "^7.3.4 || ^8.0",
        "symfony/event-dispatcher-contracts": "^2.5.3 || ^3.4.2",
        "symfony/framework-bundle": "^7.3 || ^8.0",
        "symfony/http-foundation": "^7.3 || ^8.0",
        "symfony/http-kernel": "^7.3 || ^8.0",
        "symfony/mcp-bundle": "^0.13 || ^0.14",
        "symfony/polyfill-uuid": "^1.20",
        "symfony/process": "^7.4 || ^8.1",
        "symfony/translation": "^6.4.3 || ^7.0.3 || ^8.0",
        "symfony/translation-contracts": "^2.5.3 || ^3.4.2",
        "symfony/uid": "^5.4.35 || ^6.4.3 || ^7.3 || ^8.0",
        "symfony/yaml": "^7.3 || ^8.0",
        "tomasvotruba/type-coverage": "^2.5.1"
    },
    "conflict": {
        "laravel/mcp": "<1.0",
        "mcp/sdk": "<0.8.1"
    },
    "suggest": {
        "ext-pcntl": "Delivers the queued events when a CLI server (an MCP stdio server) gets SIGTERM or SIGINT",
        "ext-posix": "Ends the process with the signal after that delivery, and finds the home directory for agentcat.log when HOME is not set",
        "laravel/mcp": "Tracks every laravel/mcp server of a Laravel application, through the auto-discovered service provider",
        "mcp/sdk": "Track mcp/sdk servers with AgentCat::track($builder, $projectId)",
        "symfony/mcp-bundle": "Tracks every symfony/mcp-bundle server through AgentCat\\Symfony\\AgentCatBundle"
    },
    "minimum-stability": "stable",
    "autoload": {
        "psr-4": {
            "AgentCat\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AgentCat\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "infection/extension-installer": true,
            "php-http/discovery": false,
            "phpstan/extension-installer": true
        },
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "AgentCat\\Laravel\\AgentCatServiceProvider"
            ]
        }
    },
    "scripts": {
        "check": [
            "@composer validate --strict",
            "@composer normalize --dry-run",
            "@cs:check",
            "@rector:check",
            "@stan",
            "@deps",
            "@test"
        ],
        "cs:check": "php-cs-fixer check --diff",
        "cs:fix": "php-cs-fixer fix",
        "deps": "composer-dependency-analyser",
        "mutation": "infection --threads=max --show-mutations",
        "rector:check": "rector process --dry-run",
        "stan": [
            "phpstan analyse --no-progress --memory-limit=1G",
            "phpstan analyse --no-progress --memory-limit=1G --configuration=phpstan.php85.neon"
        ],
        "test": "phpunit"
    }
}
